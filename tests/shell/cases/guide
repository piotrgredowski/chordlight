#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd)
env -u DISPLAY QT_QPA_PLATFORM=minimal QT_QPA_PLATFORMTHEME= \
  qmltestrunner -input "$root/tests/qml/tst_guide.qml" -o -,txt
grep -q 'GuideModel.hasMatchingPrefix' "$root/SuperGuide.qml"
grep -q 'anchors { bottom: true; left: true; right: true }' "$root/SuperGuide.qml"
grep -q 'mask: Region {}' "$root/SuperGuide.qml"
grep -q 'text: String(modelData || "").toUpperCase()' "$root/SuperGuide.qml"
grep -q 'text: "+"' "$root/SuperGuide.qml"
if rg -q 'canopyLayout|guideBackdrop|HoverHandler|overflowPill|guideTopOffset|gradient: Gradient' "$root/SuperGuide.qml"; then
  echo "the compact hint must not retain the canopy, backdrop, or top-offset UI" >&2
  exit 1
fi
if rg -q 'Color\.menu\.selectedBackground|guideLayout|deckCanvas' "$root/SuperGuide.qml"; then
  echo "the compact key outline must not retain the filled tree cards" >&2
  exit 1
fi
