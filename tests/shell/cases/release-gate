#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd)
runtime_files="$root/bridge.lua $root/Service.qml $root/Panel.qml $root/SuperGuide.qml $root/ChordHintPill.qml $root/BarWidget.qml $root/ServiceModel.js $root/GuideModel.js $root/scripts/bridge-control $root/scripts/debug-trace $root/scripts/generate-catalog"

for entry in manifest.json BarWidget.qml Panel.qml Service.qml SuperGuide.qml ChordHintPill.qml bridge.lua ServiceModel.js GuideModel.js scripts/bridge-control scripts/debug-trace scripts/generate-catalog; do
  test -f "$root/$entry"
done
test -s "$root/preview.png"
test -s "$root/assets/screenshots/settings-panel.png"
grep -Fq 'preview.png' "$root/README.md"
grep -Fq 'assets/screenshots/settings-panel.png' "$root/README.md"
grep -Fq 'https://github.com/zaremb/chordlight.git' "$root/README.md"
grep -Fq 'omarchy plugin update io.github.zaremb.chordlight' "$root/README.md"

jq -e '
  .schemaVersion == 1 and
  .id == "io.github.zaremb.chordlight" and
  .name == "Chordlight" and
  .version == "0.2.1" and
  .author == "zaremb" and
  .license == "MIT" and
  (.kinds == ["bar-widget", "service"]) and
  (.entryPoints.barWidget == "BarWidget.qml") and
  (.entryPoints.service == "Service.qml") and
  (has("overlay") | not)
' "$root/manifest.json" >/dev/null
if grep -Fq 'io.github.sai' "$root/manifest.json" || grep -Eq '"author"[[:space:]]*:[[:space:]]*"sai"' "$root/manifest.json"; then
  echo "manifest contains the retired author identity" >&2
  exit 1
fi

qmllint -I /usr/share/omarchy/shell \
  "$root/BarWidget.qml" "$root/Panel.qml" "$root/Service.qml" \
  "$root/SuperGuide.qml" "$root/ChordHintPill.qml"
luac -p "$root/bridge.lua"

# No activity history, XP system, or full-browser overlay may remain in a
# release whose privacy model is guide-only.
for removed in Overlay.qml Stats.js Recommendations.js scripts/stats-store; do
  if [ -e "$root/$removed" ]; then
    echo "removed privacy-risk surface still present: $removed" >&2
    exit 1
  fi
done
if rg -n -i 'stats\.json|recordStatsObservation|dailyQuest|totalXp|streak|recommendations' $runtime_files; then
  echo "legacy activity persistence or gamification remains in runtime code" >&2
  exit 1
fi

if rg -n 'io\.github\.cyprusad|omakeez:v1:|/omarchy/omakeez|Omakeez managed bridge|__omakeez_bridge_state' $runtime_files; then
  echo "runtime code contains retired Omakeez internal identifiers" >&2
  exit 1
fi

# Runtime code must not contain network clients, privilege escalation, dynamic
# evaluation, or shell command injection helpers. The panel's single audited
# GitHub bridge-source link is intentionally browser-mediated, not a runtime
# network client, and is checked separately below.
if rg -n -i '(^|[^[:alnum:]_])(curl|wget|socat|nc|netcat|pkexec|sudo|doas|eval)([^[:alnum:]_]|$)|urllib|requests' $runtime_files; then
  echo "forbidden runtime API or network client found" >&2
  exit 1
fi
if rg -n -i 'https?://' "$root/Panel.qml" | grep -Fv 'https://github.com/zaremb/chordlight/blob/main/bridge.lua'; then
  echo "unexpected external runtime URL found" >&2
  exit 1
fi

# The input callback is deliberately constant-time and must not do I/O,
# process creation, or file operations.
callback=$(mktemp)
trap 'rm -f "$callback"' EXIT
sed -n '/hl.on("input.keyboard.key"/,/^end)/p' "$root/bridge.lua" > "$callback"
if rg -n 'io\.|os\.|require\("socket|hyprctl|Process|File|open\(|write\(|read\(' "$callback"; then
  echo "input callback contains I/O or process work" >&2
  exit 1
fi

# Verify generated catalog JSON/Lua remain schema-safe and never persist
# dispatcher arguments.
out=$(mktemp -d)
trap 'rm -rf "$out"; rm -f "$callback"' EXIT
"$root/scripts/generate-catalog" \
  --hyprctl-file "$root/tests/fixtures/catalog-binds.txt" \
  --keymap-file "$root/tests/fixtures/catalog-keymap.txt" \
  --output-dir "$out" >/dev/null
jq -e '
  .schemaVersion == 1 and
  (.sourceHash | startswith("sha256:")) and
  (.bindings | length == 7) and
  all(.bindings[]; (.id | startswith("sha256:")) and (.xkbCodes | type == "array") and (has("arg") | not) and (has("argument") | not))
' "$out/catalog.json" >/dev/null
luac -p "$out/bridge-catalog.lua"
! grep -Fq 'secret' "$out/bridge-catalog.lua"

echo "release gate static checks passed"
